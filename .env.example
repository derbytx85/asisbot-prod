# AsisBot — variables de entorno (copia este archivo a .env)
#
# Supabase: Project Settings → API
#   URL       → NEXT_PUBLIC_SUPABASE_URL
#   service_role (secret) → SUPABASE_SERVICE_ROLE_KEY
#
# Las tablas usadas (nombres exactos): Zone, Worker, CheckIn, Consent,
# Correction, Alert. El endpoint POST /api/demo/reset las llena con datos
# ficticios de la demo.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
#
# IA real (opcional, plan gratuito de Google AI Studio):
#   Crea la clave en https://aistudio.google.com/app/apikey (sin tarjeta)
#   y ponla aquí o como variable de entorno en Vercel. Sin clave, el
#   análisis de marcaciones usa el modo simulado y la demo sigue igual.
#   GEMINI_MODEL es opcional; por defecto prueba gemini-3-flash-preview,
#   gemini-3.5-flash y gemini-flash-latest en ese orden.
GEMINI_API_KEY=TU_CLAVE_GEMINI
# GEMINI_MODEL=gemini-3-flash-preview
#
# Motor del agente (opcional, por defecto "propio"):
#   AI_ENGINE=propio  agente de reglas de AsisBot (sin costo, sin llamadas
#                     externas; es el motor por defecto).
#   AI_ENGINE=gemini  usa Gemini si GEMINI_API_KEY está puesta; si no hay
#                     clave o Gemini no responde, cae al agente propio.
# AI_ENGINE=propio
